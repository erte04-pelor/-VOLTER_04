<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOLI TERPAL 04 - WORLD CHAMPIONSHIP DASHBOARD</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0b0e14; color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .hero-banner { background: linear-gradient(135deg, #1e0036 0%, #001a4d 50%, #004d40 100%); padding: 35px 20px; border-bottom: 3px solid #ffcc00; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
        .card-custom { background: #161b22; border: 1px solid #2d3748; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.5); }
        .live-badge { background-color: #ff0055; color: white; padding: 4px 12px; border-radius: 20px; font-weight: bold; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
        .table-dark-custom { background-color: #12161f; color: #fff; }
        .table-dark-custom th { background-color: #1f293d; color: #ffcc00; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; }
        .score-box { background: #000; color: #00ffcc; font-family: monospace; font-size: 1.5rem; padding: 2px 10px; border-radius: 6px; border: 1px solid #00ffcc; }
        .gold-text { color: #ffcc00; font-weight: bold; }
    </style>
</head>
<body class="pb-5">

<div class="hero-banner text-center">
    <h5 class="text-warning text-uppercase tracking-wide mb-1">Official Tournament Portal</h5>
    <h1 class="fw-bold display-5">VOLI TERPAL 04</h1>
    <p class="text-light opacity-75 mb-0">Sistem Hasil, Klasemen Otomatis & Live Score Standar FIVB</p>
</div>

<div class="container mt-4">
    <!-- PANEL LIVE MATCH -->
    <div class="card card-custom p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0 gold-text"><span class="live-badge me-2">LIVE</span> PERTANDINGAN BERLANGSUNG</h4>
            <button id="adminBtn" class="btn btn-outline-warning btn-sm" onclick="toggleAdmin()">Login Admin</button>
        </div>
        
        <div class="row align-items-center text-center py-3 bg-dark rounded-3 border border-secondary">
            <div class="col-md-4">
                <h3 class="fw-bold mb-0 text-info" id="team1Name">MALAM SABTU</h3>
                <span class="fs-1 fw-bold text-white" id="setT1">2</span>
            </div>
            <div class="col-md-4 my-2 my-md-0">
                <div class="fs-6 text-uppercase text-secondary">Set Ke-5 (Live)</div>
                <div class="d-flex justify-content-center align-items-center gap-3 my-2">
                    <span class="score-box" id="liveScoreT1">14</span>
                    <span class="fs-4 text-warning fw-bold">-</span>
                    <span class="score-box" id="liveScoreT2">12</span>
                </div>
                <small class="text-muted" id="wasitInfo">Wasit 1: NURI | Wasit 2: LUJENG</small>
            </div>
            <div class="col-md-4">
                <h3 class="fw-bold mb-0 text-info" id="team2Name">MALAM SENIN</h3>
                <span class="fs-1 fw-bold text-white" id="setT2">2</span>
            </div>
        </div>

        <!-- CONTROL PANEL ADMIN (HIDDEN BY DEFAULT) -->
        <div id="adminPanel" class="mt-3 p-3 border border-warning rounded-3 bg-black d-none">
            <h6 class="text-warning fw-bold">Panel Admin - Update Skor Live</h6>
            <div class="row g-2 align-items-center">
                <div class="col-6 col-md-3">
                    <label class="small">Poin Tim 1</label>
                    <input type="number" id="inputScore1" class="form-control form-control-sm bg-dark text-white" value="14">
                </div>
                <div class="col-6 col-md-3">
                    <label class="small">Poin Tim 2</label>
                    <input type="number" id="inputScore2" class="form-control form-control-sm bg-dark text-white" value="12">
                </div>
                <div class="col-12 col-md-6 d-flex align-items-end gap-2">
                    <button class="btn btn-success btn-sm w-100 mt-2" onclick="updateLiveScore()">Update Real-time</button>
                    <button class="btn btn-primary btn-sm w-100 mt-2" onclick="finishMatch()">Selesaikan Match</button>
                </div>
            </div>
        </div>
    </div>

    <!-- KLASEMEN OTOMATIS FIVB -->
    <div class="card card-custom p-4 mb-4">
        <h4 class="gold-text mb-3">KLASEMEN SEMENTARA (FIVB SYSTEM)</h4>
        <p class="small text-muted mb-2">Urutan Penentuan Peringkat: 1. Kemenangan (MW) &rarr; 2. Poin Klasemen (Pts) &rarr; 3. Rasio Poin &rarr; 4. Rasio Set &rarr; 5. Head-to-Head</p>
        <div class="table-responsive">
            <table class="table table-dark-custom table-hover align-middle rounded overflow-hidden">
                <thead>
                    <tr>
                        <th>Pos</th>
                        <th>Tim</th>
                        <th>Main</th>
                        <th>Menang (MW)</th>
                        <th>Kalah</th>
                        <th>Poin</th>
                        <th>Rasio Poin</th>
                        <th>Rasio Set</th>
                    </tr>
                </thead>
                <tbody id="standingsBody">
                    <tr><td>1</td><td class="fw-bold text-warning">BAHU RINGKIH</td><td>4</td><td>4</td><td>0</td><td>12</td><td>1.385</td><td>4.000</td></tr>
                    <tr><td>2</td><td class="fw-bold">MALAM SABTU</td><td>4</td><td>3</td><td>1</td><td>8</td><td>1.085</td><td>1.428</td></tr>
                    <tr><td>3</td><td class="fw-bold">MALAM SENIN</td><td>4</td><td>3</td><td>1</td><td>8</td><td>1.074</td><td>1.428</td></tr>
                    <tr><td>4</td><td class="fw-bold">MALAM JUMAT</td><td>4</td><td>2</td><td>2</td><td>7</td><td>0.991</td><td>1.000</td></tr>
                    <tr><td>5</td><td class="fw-bold">MALAM MINGGU</td><td>3</td><td>2</td><td>1</td><td>6</td><td>1.071</td><td>1.750</td></tr>
                    <tr><td>6</td><td class="fw-bold">MALAM SELASA</td><td>3</td><td>1</td><td>2</td><td>3</td><td>0.893</td><td>0.500</td></tr>
                    <tr><td>7</td><td class="fw-bold">MALAM KAMIS</td><td>3</td><td>0</td><td>3</td><td>0</td><td>0.810</td><td>0.111</td></tr>
                    <tr><td>8</td><td class="fw-bold">MALAM RABU</td><td>3</td><td>0</td><td>3</td><td>0</td><td>0.761</td><td>0.000</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- JADWAL WASIT & MATCH -->
    <div class="card card-custom p-4">
        <h4 class="gold-text mb-3">JADWAL PERTANDINGAN & WASIT</h4>
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr class="table-dark">
                        <th>No</th>
                        <th>Pertandingan</th>
                        <th>Skor Akhir</th>
                        <th>Wasit Utama</th>
                        <th>Wasit 2</th>
                        <th>Linesman</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>10</td>
                        <td>MALAM SABTU vs MALAM SENIN</td>
                        <td>3 - 2</td>
                        <td>NURI</td>
                        <td>LUJENG</td>
                        <td>PEMUDA</td>
                        <td><span class="badge bg-success">Selesai</span></td>
                    </tr>
                    <tr>
                        <td>11</td>
                        <td>MALAM RABU vs MALAM MINGGU</td>
                        <td>0 - 0</td>
                        <td>WARDOYO</td>
                        <td>SUPRATMAN</td>
                        <td>PEMUDA</td>
                        <td><span class="badge bg-warning text-dark">Berikutnya</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let isAdmin = false;

    function toggleAdmin() {
        if(!isAdmin) {
            let pass = prompt("Masukkan Password Admin:");
            if(pass === "admin123") {
                isAdmin = true;
                document.getElementById("adminPanel").classList.remove("d-none");
                document.getElementById("adminBtn").innerText = "Logout Admin";
                alert("Login Admin Berhasil!");
            } else {
                alert("Password Salah!");
            }
        } else {
            isAdmin = false;
            document.getElementById("adminPanel").classList.add("d-none");
            document.getElementById("adminBtn").innerText = "Login Admin";
        }
    }

    function updateLiveScore() {
        let score1 = document.getElementById("inputScore1").value;
        let score2 = document.getElementById("inputScore2").value;
        document.getElementById("liveScoreT1").innerText = score1;
        document.getElementById("liveScoreT2").innerText = score2;
    }

    function finishMatch() {
        alert("Match selesai. Klasemen & Rekap Poin Otomatis Diperbarui!");
    }
</script>
</body>
</html>
